{
  "name": "virlux",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "bash scripts/dev-local.sh",
    "dev:stack": "concurrently -n web,app,api -c cyan,magenta,green \"npm run dev:safe -w @virlux/web\" \"npm run dev -w @virlux/app\" \"npm run dev -w @virlux/api\"",
    "dev:web": "npm run dev:safe -w @virlux/web",
    "build": "npm run build -w @virlux/shared && npm run build -w @virlux/api && npm run build -w @virlux/web && npm run build -w @virlux/app",
    "test": "npm run test -w @virlux/api && npm run test -w @virlux/shared",
    "db:generate": "npm run db:generate -w @virlux/api",
    "db:push": "npm run db:push -w @virlux/api",
    "db:migrate": "npm run db:migrate -w @virlux/api",
    "db:seed": "npm run db:seed -w @virlux/api",
    "deploy:checklist": "bash scripts/deploy.sh",
    "deploy:smoke": "bash scripts/staging-smoke.sh",
    "smoke:custom-domains": "bash scripts/smoke-custom-domains.sh",
    "verify:live": "bash scripts/verify-live.sh",
    "verify:analytics": "bash scripts/verify-analytics.sh",
    "verify:book-demo": "bash scripts/verify-book-demo.sh",
    "verify:supabase-security": "bash scripts/verify-supabase-security.sh",
    "verify:security-headers": "bash scripts/verify-security-headers.sh",
    "verify:full": "bash scripts/verify-full.sh",
    "agent:self-audit": "bash scripts/agent-self-audit.sh",
    "plan:virlux-1000:generate": "python3 scripts/generate-virlux-1000-prompts.py",
    "plan:no-asf:pick": "bash scripts/pick-virlux-no-asf-plan.sh",
    "deploy:secrets": "bash scripts/generate-staging-secrets.sh",
    "deploy:push-setup": "bash scripts/setup-github-push.sh",
    "staging:prepare": "bash scripts/staging-prepare-env.sh",
    "staging:railway": "bash scripts/staging-railway-deploy.sh",
    "staging:wire": "bash scripts/staging-wire-production.sh",
    "staging:vercel": "bash scripts/staging-vercel-deploy.sh",
    "staging:vercel-api": "bash scripts/staging-vercel-api-deploy.sh",
    "staging:supabase-db": "bash scripts/staging-supabase-db-url.sh",
    "staging:vercel-api-env": "bash scripts/staging-vercel-api-env-sync.sh",
    "staging:vercel-env": "bash scripts/staging-vercel-env-sync.sh",
    "staging:local": "bash scripts/staging-local-verify.sh",
    "staging:e2e": "bash scripts/staging-e2e.sh",
    "staging:partner-e2e": "bash scripts/staging-partner-e2e.sh",
    "staging:live-e2e": "bash scripts/staging-live-cookie-e2e.sh",
    "staging:platform-setup": "bash scripts/staging-platform-setup.sh",
    "staging:deploy-all": "bash scripts/staging-deploy-all.sh",
    "staging:validate-env": "bash scripts/staging-validate-env.sh",
    "staging:reseed-demo": "bash scripts/staging-reseed-demo.sh",
    "staging:migrate": "bash scripts/staging-migrate-deploy.sh",
    "founder:security-checklist": "bash scripts/founder-security-checklist.sh",
    "founder:sync-gtm-env": "bash scripts/sync-founder-gtm-env.sh",
    "founder:enroll-mfa": "bash scripts/enroll-platform-mfa.sh",
    "setup:supabase-anon-probe": "bash scripts/setup-supabase-anon-probe.sh",
    "wire:vercel-domains": "bash scripts/wire-vercel-domains.sh",
    "live-pilot:deploy-check": "bash scripts/live-pilot-deploy-check.sh",
    "post-deploy:verify": "bash scripts/post-deploy-verify.sh",
    "gtm:capture-screenshots": "bash scripts/capture-product-screenshots.sh",
    "staging:circle": "bash scripts/circle-sandbox-check.sh",
    "security:clean": "bash scripts/security-clean.sh",
    "security:revoke-sessions": "bash scripts/revoke-all-sessions.sh",
    "ci:guards": "bash scripts/ci-guards.sh",
    "postinstall": "node -e \"require('child_process').execSync('npm run db:generate -w @virlux/api',{stdio:'inherit'})\"",
    "dev:preflight": "bash scripts/dev-preflight.sh",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui"
  },
  "devDependencies": {
    "@playwright/test": "^1.51.0",
    "@railway/cli": "^4.65.0",
    "concurrently": "^9.1.2",
    "typescript": "^5.7.3",
    "vercel": "^54.6.1"
  }
}
