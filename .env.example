# Ports (do not use 3000, 8000, or 8020)
WEB_PORT=3100
APP_PORT=3001
API_PORT=3002
NODE_ENV=development

# PostgreSQL — run: docker compose up -d postgres
DATABASE_URL=postgresql://virlux:virlux@localhost:5432/virlux
DIRECT_URL=postgresql://virlux:virlux@localhost:5432/virlux

# Supabase: Postgres host only — never expose anon/service_role keys in frontend env vars.
# Prisma migrations must ENABLE ROW LEVEL SECURITY + REVOKE ALL FROM anon, authenticated.

JWT_SECRET=change-me-in-production-use-long-random-string-min-32-chars
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL_DAYS=30

# Dev-only simulated settlement — MUST be false in production
AUTO_SETTLE=true
SETTLEMENT_MODE=sandbox
# Production (SYSTEM.md v3.1): SETTLEMENT_MODE=partner
# Dev/staging experiments only: SETTLEMENT_MODE=direct
# REQUIRE_PARTNER_DEPOSIT=true
# ALLOW_ORG_DEPOSIT_CONFIRM=false
APPROVAL_THRESHOLD=5000
CORS_ORIGINS=http://localhost:3100,http://localhost:3001
PORT=3002
RATE_LIMIT_MAX=120
AUTH_RATE_LIMIT_MAX=10
QUOTE_ESTIMATE_RATE_LIMIT_MAX=30
# Production/staging: keep false unless intentionally opening signups
# ALLOW_OPEN_REGISTRATION=false

# Official VIRLUX bot (@VIRLUXBOT)
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_NAME=VIRLUXBOT
TELEGRAM_MODE=polling
TELEGRAM_WEBHOOK_URL=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_ADMIN_CHAT_IDS=

# Circle sandbox — https://developers.circle.com
CIRCLE_API_KEY=
CIRCLE_SANDBOX=true
CIRCLE_WALLET_ID=

# Platform ops (cross-org MSB console) — comma-separated admin emails
PLATFORM_ADMIN_EMAILS=contact@virlux.com,demo@virlux.com
DEPOSIT_WEBHOOK_SECRET=dev-deposit-webhook-secret-min-16

NEXT_PUBLIC_API_URL=http://localhost:3002
NEXT_PUBLIC_APP_URL=http://localhost:3001
NEXT_PUBLIC_WEB_URL=http://localhost:3100
# Optional: Calendly or HubSpot meeting URL for "Book a demo" CTAs
NEXT_PUBLIC_BOOK_DEMO_URL=

# Local/staging demo UX only (never production)
# NEXT_PUBLIC_DEMO_MODE=true
