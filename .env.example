# Ports (do not use 3000, 8000, or 8020)
WEB_PORT=3100
APP_PORT=3001
API_PORT=3002
NODE_ENV=development

# PostgreSQL — run: docker compose up -d postgres
DATABASE_URL=postgresql://virlux:virlux@localhost:5432/virlux

JWT_SECRET=change-me-in-production-use-long-random-string-min-32-chars
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL_DAYS=30

# Dev-only simulated settlement — MUST be false in production
AUTO_SETTLE=true
APPROVAL_THRESHOLD=5000
CORS_ORIGINS=http://localhost:3100,http://localhost:3001
PORT=3002
RATE_LIMIT_MAX=120
AUTH_RATE_LIMIT_MAX=10

# Official VIRLUX bot (@VIRLUXBOT)
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_NAME=VIRLUXBOT
TELEGRAM_MODE=polling
TELEGRAM_WEBHOOK_URL=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_ADMIN_CHAT_IDS=

# Circle sandbox — https://developers.circle.com
CIRCLE_API_KEY=
CIRCLE_SANDBOX=true
CIRCLE_WALLET_ID=

NEXT_PUBLIC_API_URL=http://localhost:3002
NEXT_PUBLIC_APP_URL=http://localhost:3001
NEXT_PUBLIC_WEB_URL=http://localhost:3100
