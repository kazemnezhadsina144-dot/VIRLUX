# VIRLUX staging — copy values into Railway + Vercel dashboards (never commit real secrets)
# Generate secrets: ./scripts/generate-staging-secrets.sh

NODE_ENV=production

# --- Railway API service ---
PORT=3002
DATABASE_URL=postgresql://USER:PASS@HOST:5432/railway

JWT_SECRET=REPLACE-min-32-chars-use-generate-staging-secrets-sh
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL_DAYS=30

AUTO_SETTLE=false
SETTLEMENT_MODE=partner
ALLOW_ORG_DEPOSIT_CONFIRM=false
APPROVAL_THRESHOLD=5000
# Staging demos: lower threshold for maker-checker walkthrough
DEMO_APPROVAL_THRESHOLD=100
# Staging demo fund button (never production)
DEMO_FUND_ENABLED=true
RATE_LIMIT_MAX=120
AUTH_RATE_LIMIT_MAX=10

# Comma-separated Vercel staging URLs (no trailing slashes)
CORS_ORIGINS=https://YOUR-WEB.vercel.app,https://YOUR-APP.vercel.app

# Telegram @VIRLUXBOT — webhook mode on Railway
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_NAME=VIRLUXBOT
TELEGRAM_MODE=webhook
TELEGRAM_WEBHOOK_URL=https://YOUR-API.up.railway.app/api/telegram/webhook
TELEGRAM_WEBHOOK_SECRET=REPLACE-min-16-chars-use-generate-staging-secrets-sh
TELEGRAM_ADMIN_CHAT_IDS=

# Circle sandbox (staging)
CIRCLE_API_KEY=
CIRCLE_SANDBOX=true
CIRCLE_WALLET_ID=

# Circle webhook (production) — POST /api/circle/webhook
CIRCLE_WEBHOOK_SECRET=

# Platform admin (comma-separated emails for cross-org ops console)
PLATFORM_ADMIN_EMAILS=contact@virlux.com,demo@virlux.com

# Inbound Interac webhook from MSB partner (min 16 chars)
DEPOSIT_WEBHOOK_SECRET=REPLACE-min-16-chars-use-generate-staging-secrets-sh

# Public URLs (Railway + Vercel)
NEXT_PUBLIC_API_URL=https://YOUR-API.up.railway.app
NEXT_PUBLIC_APP_URL=https://YOUR-APP.vercel.app
NEXT_PUBLIC_WEB_URL=https://YOUR-WEB.vercel.app
# Calendly / HubSpot — e.g. https://calendly.com/your-link/virlux-demo
NEXT_PUBLIC_BOOK_DEMO_URL=

# Staging app only — demo UX (never set on production)
NEXT_PUBLIC_DEMO_MODE=true
# Optional Loom embed on marketing /demo page
NEXT_PUBLIC_DEMO_LOOM_URL=
# Optional Plausible analytics (privacy-safe)
NEXT_PUBLIC_ANALYTICS_DOMAIN=

# --- Vercel only (web + app projects) ---
# Set NEXT_PUBLIC_API_URL, NEXT_PUBLIC_APP_URL, NEXT_PUBLIC_WEB_URL on both Vercel projects.
